# Copy these NAMES into your hosting dashboard's environment variables at deployment.
# Do not put real values in this file or commit them.

# --- Login / security ---
APP_PASSWORD=            # optional; defaults to the staff password you asked for
JWT_SECRET=              # long random string (keeps logins valid across restarts)

# --- Firebase (Firestore replaces MongoDB). Use ONE of the two options ---
# Option 1: the whole service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT=
# Option 2: the three individual values from the service-account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=    # keep the \n line breaks as-is

# --- Optional: AI-written, syllabus-specific questions ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=5000            # local only
