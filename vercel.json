{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "{server/assets/**,server/store/**,node_modules/@tesseract.js-data/eng/**,node_modules/tesseract.js-core/**,node_modules/tesseract.js/**}"
    }
  }
}
